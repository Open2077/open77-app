{
  "name": "open77-app",
  "version": "1.0.0",
  "private": true,
  "description": "OPEN//77 web application — marketing site, server browser and documentation for the Cyberpunk 2077 multiplayer platform.",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "sync:wiki": "node scripts/sync-wiki.mjs",
    "sync:wiki:check": "node scripts/sync-wiki.mjs --check",
    "verify:content": "node scripts/sync-wiki.mjs --check && node scripts/check-coverage.mjs && node scripts/check-api-overlays.mjs && node scripts/check-api-markup.mjs",
    "verify:served": "node scripts/smoke.mjs && node scripts/inspect-links.mjs && node scripts/check-hydration.mjs",
    "smoke": "node scripts/smoke.mjs",
    "inspect:output": "node scripts/inspect-output.mjs",
    "inspect:links": "node scripts/inspect-links.mjs",
    "inspect:prose": "node scripts/inspect-prose.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "build:brand": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.3",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  }
}
